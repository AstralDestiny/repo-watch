# HOST_UID=1000
# HOST_GID=1000

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
GITHUB_TOKEN=

# Comma-separated Discord user snowflakes allowed to mirror messages → GitHub
ALLOWED_DISCORD_USER_IDS=

# Optional: comma-separated role IDs that may also mirror
ALLOWED_ROLE_IDS=

# Optional: override GitHub login used for poller dedupe (default: from PAT via GET /user — do not set unless you need a mismatch)
# GITHUB_ACTOR_LOGIN=

CONFIG_PATH=/app/config/repos.json
DATABASE_PATH=/app/data/bot.db
POLL_INTERVAL_MS=90000
